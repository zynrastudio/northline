# Local n8n (Docker Compose) — copy to .env and fill secrets.
# Never commit .env.

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Los_Angeles

# Generate a random 32+ character string (keep stable across restarts).
# Example: powershell -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
N8N_ENCRYPTION_KEY=

# Shared secret for Next.js → n8n webhook header (G2/G3).
# Header name: X-Northline-Webhook-Secret
# G2 test value used on MCP + Railway workflows: northline-g2-dev-secret
# Rotate before production; store only in Railway vars + this local .env (never commit).
N8N_WEBHOOK_SECRET=
