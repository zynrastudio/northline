# Public site URL (used for canonical URLs, sitemap, robots).
# Future marketing domain (pending purchase): https://northlinecreative.online
# Local/dev default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com strategy consultation event (qualified success CTA + prospect email)
# Prefill: name + email query params are appended automatically
# After booking, set Cal.com "Redirect on booking" to:
#   {NEXT_PUBLIC_SITE_URL}/book-consultation/booked
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/northlinecreative/strategy-consultation

# Google Analytics 4 measurement ID (optional in local dev)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set true to send events with debug_mode for GA4 DebugView
NEXT_PUBLIC_GA_DEBUG=true

# n8n consultation intake (G3) — Railway staging preferred for Next.js
# Example: https://n8n-production-26316.up.railway.app/webhook/consultation-intake
# Alternate MCP cloud: https://brightakolade.app.n8n.cloud/webhook/consultation-intake
# Header sent: X-Northline-Webhook-Secret
# Soft-fail: missing env or webhook errors still allow form success + Resend (Mode A)
# unless AUTOMATION_FALLBACK_EMAIL=false (hard-fail form when n8n is down)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# When true/unset: n8n failures still send Resend (Mode A). When false: form errors if n8n down.
AUTOMATION_FALLBACK_EMAIL=true

# Resend API key for contact form email delivery
# https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives consultation requests (defaults to hello@northlinecreative.com)
CONTACT_TO_EMAIL=

# Verified sender in Resend. For testing you can use:
# Northline Creative <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Northline Creative <onboarding@resend.dev>
